# Token del bot, dalla Developer Portal (Bot > Token)
DISCORD_TOKEN=

# Application ID / Client ID del bot (Developer Portal > General Information)
CLIENT_ID=1546444444549775380

# Opzionale: ID di un server per testare i comandi (si aggiornano all'istante,
# invece di aspettare fino a un'ora per il deploy globale). Lascia vuoto per il deploy globale.
GUILD_ID=

# URL del database Postgres. Su Railway: aggiungi il plugin "PostgreSQL" al progetto,
# poi copia la variabile DATABASE_URL che Railway genera automaticamente.
DATABASE_URL=
